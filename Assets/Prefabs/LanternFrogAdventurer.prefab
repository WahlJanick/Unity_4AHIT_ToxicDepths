--- !u!114 &6131171149248953107
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7395687398863434312}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5db5eb3c98a54c8d94bf17437afd6300, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ToxicDepths.FrogGreeting
  speechBubble: {fileID: 7058703327666437955}
  speechText: {fileID: 7293014586783667470}
  firstChoice: {fileID: 1927703687282741373}
  secondChoice: {fileID: 1690554338260527869}
  nodes:
  - id: greeting
    line: Servus! Ich bin Sepp. Zum ersten Mal hier unten?
    first:
      label: Ja. Was erwartet mich?
      nextNode: mine
    second:
      label: Was machst du hier?
      nextNode: stand
  - id: mine
    line: "Oben ist es noch ruhig. Tiefer unten gibt\u2019s besseres Erz. Fr\xFCher bin ich selbst hinunter."
    first:
      label: Wieso nicht mehr?
      nextNode: past
    second:
      label: "Wie finde ich zur\xFCck?"
      nextNode: wayBack
  - id: stand
    line: "Ich halte hier die Stellung. Fr\xFCher war ich selbst Sch\xFCrfer. Die Laterne ist noch von damals."
    first:
      label: "Erz\xE4hl mir davon."
      nextNode: past
    second:
      label: Was liegt tiefer unten?
      nextNode: mine
  - id: past
    line: "Unten ging mir mal das Licht aus. Ich hab mich an der Wand bis hierher zur\xFCckgetastet."
    first:
      label: Wie vermeide ich das?
      nextNode: wayBack
    second:
      label: "Das klingt \xFCbel."
      nextNode: farewell
  - id: wayBack
    line: "Merk dir die Abzweigungen auf dem Hinweg. Auf dem R\xFCckweg schaut alles anders aus."
    first:
      label: Danke, Sepp.
      nextNode: farewell
    second:
      label: Was machst du hier?
      nextNode: stand
  - id: farewell
    line: "Pass auf dich auf. Wenn du zur\xFCckkommst, erz\xE4hl mir, was du unten gefunden hast."
    first:
      label: "Mach ich. Bis sp\xE4ter!"
      nextNode: 
    second:
      label: Eine Frage zur Mine.
      nextNode: mine
